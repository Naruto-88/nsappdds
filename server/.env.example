# Copy this file to .env and fill in real values. Never commit .env.

# From Google Cloud Console → APIs & Services → Credentials (OAuth 2.0 Client ID,
# type "Web application"). Redirect URI registered there must exactly match
# GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Restricts dashboard login to accounts on this Google Workspace domain
# (adds hd=<domain> to the consent URL). Leave blank to allow any Google account.
ALLOWED_HD=netstripes.com

# Secret used to sign the dashboard's session cookie (JWT). Any long random string.
SESSION_JWT_SECRET=change-me-to-a-long-random-string

# The same Google Sheet ID you paste into the dashboard's Governance tab. The
# backend reads the _CONFIG tab from this sheet to map each client's sheetKey to
# their GSC Site URL / GA4 Property ID / Google Ads Customer ID.
CONFIG_SHEET_ID=

# Google Ads API — separate from the GCP OAuth setup above. Requires applying for a
# Developer Token in the Google Ads UI (Tools & Settings → API Center) under a
# Manager (MCC) account; Google's approval can take a few business days. Without
# these two set, the Google Ads card's live fields simply stay "-" — nothing breaks.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Origin the dashboard is served from, for CORS + cookie settings. For local dev
# this is usually the file's own origin (null) or a local static server URL.
DASHBOARD_ORIGIN=http://localhost:5500

PORT=3001
